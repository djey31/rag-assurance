# Fournisseur de génération : ollama | anthropic | openai_compatible
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=mistral:7b-instruct

# Si LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Si LLM_PROVIDER=openai_compatible (Scaleway, Groq, Together...)
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

EMBEDDING_MODEL=intfloat/multilingual-e5-base
CHROMA_DIR=.chroma
TOP_K=5
